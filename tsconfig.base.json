{
  "compilerOptions": {
    "target": "ES2022",
    // Deliberately no DOM. Every package that extends this without adding it
    // back cannot reach `window`, `document` or `AudioContext` — the rule that
    // used to be a line in CLAUDE.md is a compiler error here.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "skipLibCheck": true
  }
}
